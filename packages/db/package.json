{
  "name": "db",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "npx eslint src --ext .ts",
    "generate": "drizzle-kit generate --config=drizzle.config.ts",
    "generate:auth": "drizzle-kit generate --config=drizzle.auth.config.ts",
    "generate:all": "npm run generate && npm run generate:auth",
    "migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "migrate:auth": "drizzle-kit migrate --config=drizzle.auth.config.ts",
    "migrate:all": "npm run migrate && npm run migrate:auth",
    "push": "drizzle-kit push --config=drizzle.config.ts",
    "push:auth": "drizzle-kit push --config=drizzle.auth.config.ts",
    "studio": "drizzle-kit studio --config=drizzle.config.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.30.0",
    "eslint": "^8.57.1",
    "tsx": "^4.19.0",
    "typescript": "^6.0.2"
  }
}
