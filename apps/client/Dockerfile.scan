FROM node:20-alpine AS build

WORKDIR /app

RUN apk upgrade --no-cache

COPY package*.json ./
COPY apps/auth/package.json ./apps/auth/
COPY apps/backend/package.json ./apps/backend/
COPY apps/client/package.json ./apps/client/
COPY packages/config/package.json ./packages/config/
COPY packages/db/package.json ./packages/db/

RUN npm ci --workspace=apps/client --include-workspace-root=false

COPY apps/client/ ./apps/client/

WORKDIR /app/apps/client
RUN npm run build

FROM nginx:1.27-alpine AS runtime

RUN apk upgrade --no-cache \
    && addgroup -g 1001 -S app \
    && adduser -S -D -H -u 1001 -G app app \
    && touch /var/run/nginx.pid \
    && chown app:app /var/run/nginx.pid \
    && chown -R app:app /var/cache/nginx /etc/nginx/conf.d \
    && sed -i '/^user /d' /etc/nginx/nginx.conf \
    && sed -i 's/listen       80;/listen       8080;/' /etc/nginx/conf.d/default.conf

COPY --from=build --chown=app:app /app/apps/client/dist /usr/share/nginx/html

USER app

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
