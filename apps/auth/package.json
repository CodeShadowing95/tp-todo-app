{
  "name": "auth",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "tsx -r dotenv/config src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "format": "prettier --write \"{src,spec}/**/*.{ts,js}\"",
    "format-check": "prettier --check \"{src,spec}/**/*.{ts,js}\"",
    "test": "jest --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "db": "1.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "prom-client": "^15.1.3",
    "winston": "^3.19.0"
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": true
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
